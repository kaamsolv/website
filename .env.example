# KaamKit — environment variables
#
# Copy to `.env.local` (git-ignored) for local development, or set these in the
# Vercel project (Settings → Environment Variables) per environment.
#
# LOCAL DEV NEEDS NOTHING HERE. With no DATABASE_URL the app and the migration
# runner use a local PGlite database at `.pglite/` — real Postgres, no install,
# no credentials. Only set DATABASE_URL locally if you want to point at a Neon
# dev branch.

# ---------------------------------------------------------------------------
# Database (Neon Postgres) — set on Vercel Production + Preview
# ---------------------------------------------------------------------------
# Pooled Neon connection string. Server-only secret — never exposed to the
# client, never committed. Its ABSENCE selects the PGlite driver.
DATABASE_URL=

# ---------------------------------------------------------------------------
# URL Shortener — optional
# ---------------------------------------------------------------------------
# Canonical base for generated short links. Defaults to https://kaamkit.com.
NEXT_PUBLIC_SITE_URL=

# Salt for the hashed IP stored on new links (abuse forensics only, never the
# raw IP). If unset, links are created with a null IP hash.
KK_IP_HASH_SALT=

# Reserved for later Phase 2a/2b work (not read yet):
#   KK_ANON_COOKIE_SECRET   HMAC key for the signed kk_sid recent-links cookie
#   SAFE_BROWSING_API_KEY   enables destination reputation screening
