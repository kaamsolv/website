# KaamSolv — environment variables
#
# Copy to `.env.local` (git-ignored) for local development. In production these
# are Cloudflare Worker secrets on `kaamsolv` (`npx wrangler secret put NAME`) —
# see docs/infra/deployment.md §8.
#
# LOCAL DEV NEEDS NOTHING HERE. With no DATABASE_URL the app and the migration
# runner use a local PGlite database at `.pglite/` — real Postgres, no install,
# no credentials. Only set DATABASE_URL locally if you want to point at a Neon
# dev branch.

# ---------------------------------------------------------------------------
# Database (Neon Postgres) — Worker secret in production
# ---------------------------------------------------------------------------
# Pooled Neon connection string. Server-only secret — never exposed to the
# client, never committed. Its ABSENCE selects the PGlite driver.
DATABASE_URL=

# ---------------------------------------------------------------------------
# URL Shortener
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION (Worker secret). Salt for every caller hash:
# rate-limit keys, links.created_ip_hash, link_reports.reporter_ip_hash — the
# raw IP is never stored. Use a long random string. If it's missing in production,
# shortening and reporting fail with a clear server log. Locally a fixed dev
# salt is used, so you can leave this blank.
KK_IP_HASH_SALT=

# Optional. Google Web Risk API key for destination screening (Lookup API).
# Needs a Google Cloud project with billing enabled and the Web Risk API
# enabled; restrict the key to that API. If unset, links are created without
# screening (fail-open) and the server logs that once.
WEB_RISK_API_KEY=

# Optional. Canonical base for generated short links. Defaults to https://kaamsolv.com.
NEXT_PUBLIC_SITE_URL=

# Reserved (not read yet):
#   KK_ANON_COOKIE_SECRET   HMAC key for the signed kk_sid recent-links cookie

# ---------------------------------------------------------------------------
# Accounts (docs/products/accounts.md) — Worker secrets in production
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION. Signs session cookies. Locally a fixed dev secret is
# used, so you can leave this blank. Long random string.
BETTER_AUTH_SECRET=

# Optional locally. Google OAuth web client — the "Continue with Google" button
# appears only when both are set. Add http://localhost:3000/api/auth/callback/google
# as a redirect URI on the client to test it locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional locally. Without it, sign-in links are printed to the dev server log
# (and test-results/mail-outbox.jsonl) instead of being emailed.
RESEND_API_KEY=

# Billing (docs/products/billing.md). All three are Worker secrets in production; without the first two the
# billing page says "Payments aren't switched on yet". Use Razorpay TEST-mode keys locally and in rehearsal.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Billing M2 (docs/products/billing.md). Who issues KaamSolv's sales invoices and how tax is treated. 
# Nothing is invoiced until BILLING_SELLER_EMAIL (an existing KaamSolv account with its Business profile filled in)
# and BILLING_TAX_TREATMENT are set. Treatment: none | inclusive (with BILLING_TAX_RATE, e.g. 18). Ask your CA first.
# In production set all of these with `npx wrangler secret put NAME` (not secret, but it keeps them out of the repo).
BILLING_SELLER_EMAIL=
BILLING_TAX_TREATMENT=
BILLING_TAX_RATE=
BILLING_SAC=
# Shared with the scheduled retry (a Worker secret in production).
CRON_SECRET=

# TEST ONLY — never in production, never a Worker secret. Set by
# playwright.config.ts for e2e runs; unlocks the test-only sign-in route.
# KK_E2E=
# KK_E2E_SECRET=

# Google Analytics 4 Measurement ID. Production builds get it from the committed .env.production,
# so do NOT set it here or in .env.local: .env.local outranks .env.production, and an empty or
# wrong value would silently change what a production build ships (cf:deploy's check would stop it).
# Local dev and e2e send nothing: `next dev` never reads .env.production.
# To build without analytics on purpose: NEXT_PUBLIC_GA_ID=off KK_ALLOW_NO_ANALYTICS=1 (see docs/ANALYTICS.md).
# NEXT_PUBLIC_GA_ID=
