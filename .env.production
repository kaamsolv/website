# Public GA4 Measurement ID (not a secret: it is visible in every page's JavaScript).
# Baked into the client bundle when `next build` runs, so every production build
# and deploy picks it up. To override for one build, set it in the shell; use
# NEXT_PUBLIC_GA_ID=off (with KK_ALLOW_NO_ANALYTICS=1 for cf:deploy) to build without
# analytics. See docs/ANALYTICS.md. Never put credentials in this file.
NEXT_PUBLIC_GA_ID=G-Q9YEM3Y43T
