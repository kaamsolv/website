// KaamSolv production Worker — Next.js via OpenNext (`npm run cf:deploy`).
// Hosting decision and DNS notes: docs/infra/deployment.md.
// Secrets are Worker secrets (`npx wrangler secret put NAME`), never in this file:
//   DATABASE_URL, KK_IP_HASH_SALT                       (URL Shortener, all DB use)
//   BETTER_AUTH_SECRET, GOOGLE_CLIENT_ID,
//   GOOGLE_CLIENT_SECRET, RESEND_API_KEY                (accounts — docs/products/accounts.md)
// NEVER set KK_E2E or KK_E2E_SECRET here: they unlock test-only sign-in and
// exist only in local / CI env (app/lib/e2e-gate.ts).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaamsolv",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare creates the DNS records and certificates for these itself.
  // www is redirected to the apex by next.config.mjs.
  "routes": [
    { "pattern": "kaamsolv.com", "custom_domain": true },
    { "pattern": "www.kaamsolv.com", "custom_domain": true }
  ],
  // Keep the *.workers.dev URL as a fallback for checks; pages carry a
  // kaamsolv.com canonical, so it is not indexed as a duplicate.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true }
}
